# Copie este arquivo para .env e preencha os valores.

# Nome exibido no topo do portal
PORTAL_NAME=BI Probeef

# Porta do servidor
PORT=3000

# Segredo para assinar o cookie de sessão (gere um valor longo e aleatório)
# Exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Use "production" ao publicar com HTTPS (ativa cookies seguros)
NODE_ENV=development

# --- Power BI Embedded (service principal do Azure / Entra ID) ---
# ID do locatário (Directory/tenant ID)
PBI_TENANT_ID=
# ID do aplicativo registrado (Application/client ID)
PBI_CLIENT_ID=
# Segredo do cliente do aplicativo registrado
PBI_CLIENT_SECRET=
# Workspace padrão para importar relatórios (opcional)
PBI_WORKSPACE_ID=

# Arquivo onde ficam usuários, clientes e relatórios (opcional)
# DATA_FILE=./data/db.json

# --- Endereço público do portal (links enviados pelo WhatsApp) ---
PUBLIC_URL=

# --- Assistente com IA (Claude) ---
# Cada usuário cadastra a própria chave da Anthropic no portal (Conta → Meu assistente).
# Este segredo criptografa essas chaves; gere um valor longo e não troque depois.
KEY_ENCRYPTION_SECRET=
# Limite de perguntas por usuário por dia (opcional, padrão 40)
# AI_DAILY_LIMIT=40

# --- WhatsApp (API oficial da Meta / WhatsApp Business Platform) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Texto que você inventa e repete na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Nome do modelo de mensagem aprovado para o aviso de relatório atualizado (opcional)
WHATSAPP_TEMPLATE_UPDATE=
# Modelo aprovado para os alertas/resumos da Ferramenta CCV (opcional). Corpo com 3 variáveis:
# {{1}} primeiro nome, {{2}} fazenda, {{3}} texto do alerta. Sem ele, o admin copia a mensagem
# ou abre o WhatsApp dele com o texto pronto.
WHATSAPP_TEMPLATE_CCV=
# "true" se o modelo acima foi criado com cabeçalho do tipo Documento: o PDF do relatório (filtrado
# na fazenda) vai nele e passa a ser obrigatório. Sem isso, o PDF vai solto depois do modelo e o
# WhatsApp só entrega a quem escreveu para o número nas últimas 24 horas.
WHATSAPP_TEMPLATE_CCV_PDF=
